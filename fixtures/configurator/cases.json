{
  "_notice": "SYNTHETIC TEST DATA for the hybrid configurator's dependent-option rules (docs/CATALOG_SCHEMA.md, 'Configurator derivation'). Uses fixtures/search/fixture-catalog.json products fx-aero and fx-nova only. An option is 'available' if at least one variant has that value AND matches every OTHER currently selected group; 'selected' marks the chosen value; 'unavailable' is shown disabled with a reason, never hidden and never auto-changed.",
  "schemaVersion": 1,
  "cases": [
    { "id": "K01", "intent": "nothing selected: every offered value available", "product": "fx-aero", "selection": {},
      "expected": { "options": { "screen_in": { "13": "available", "15": "available" }, "chip": { "fx1": "available", "fx2": "available" }, "ram_gb": { "8": "available", "16": "available", "32": "available" }, "storage_gb": { "256": "available", "512": "available", "1024": "available" } },
        "resolved": null, "missing": ["screen_in", "chip", "ram_gb", "storage_gb"] } },
    { "id": "K02", "intent": "screen 13 disables the 32 GB RAM and 1 TB storage that exist only on 15-inch",
      "product": "fx-aero", "selection": { "screen_in": 13 },
      "expected": { "options": { "screen_in": { "13": "selected", "15": "available" }, "chip": { "fx1": "available", "fx2": "available" }, "ram_gb": { "8": "available", "16": "available", "32": "unavailable" }, "storage_gb": { "256": "available", "512": "available", "1024": "unavailable" } },
        "resolved": null, "missing": ["chip", "ram_gb", "storage_gb"] } },
    { "id": "K03", "intent": "dependencies flow both ways: chip fx1 disables 15-inch",
      "product": "fx-aero", "selection": { "screen_in": 13, "chip": "fx1" },
      "expected": { "options": { "screen_in": { "13": "selected", "15": "unavailable" }, "chip": { "fx1": "selected", "fx2": "available" }, "ram_gb": { "8": "available", "16": "available", "32": "unavailable" }, "storage_gb": { "256": "available", "512": "available", "1024": "unavailable" } },
        "resolved": null, "missing": ["ram_gb", "storage_gb"] } },
    { "id": "K04", "intent": "complete selection resolves exactly one variant",
      "product": "fx-aero", "selection": { "screen_in": 13, "chip": "fx2", "ram_gb": 16, "storage_gb": 512 },
      "expected": { "options": { "screen_in": { "13": "selected", "15": "available" }, "chip": { "fx1": "available", "fx2": "selected" }, "ram_gb": { "8": "unavailable", "16": "selected", "32": "unavailable" }, "storage_gb": { "256": "unavailable", "512": "selected", "1024": "unavailable" } },
        "resolved": "fx-aero:13-fx2-16-512", "missing": [] } },
    { "id": "K05", "intent": "selecting an incompatible value changes nothing and names the conflict",
      "product": "fx-aero", "selection": { "screen_in": 15 }, "select": { "attr": "chip", "value": "fx1" },
      "expected": { "status": "needs_reset", "conflicts": ["screen_in"], "selection": { "screen_in": 15 } } },
    { "id": "K06", "intent": "conflict is reported against the selected group that is pairwise incompatible",
      "product": "fx-aero", "selection": { "screen_in": 13, "chip": "fx1" }, "select": { "attr": "screen_in", "value": 15 },
      "expected": { "status": "needs_reset", "conflicts": ["chip"], "selection": { "screen_in": 13, "chip": "fx1" } } },
    { "id": "K07", "intent": "32 GB RAM does not exist on 13-inch",
      "product": "fx-aero", "selection": { "screen_in": 13 }, "select": { "attr": "ram_gb", "value": 32 },
      "expected": { "status": "needs_reset", "conflicts": ["screen_in"], "selection": { "screen_in": 13 } } },
    { "id": "K08", "intent": "compatible selection is accepted",
      "product": "fx-aero", "selection": { "screen_in": 13 }, "select": { "attr": "ram_gb", "value": 16 },
      "expected": { "status": "ok", "selection": { "screen_in": 13, "ram_gb": 16 } } },
    { "id": "K09", "intent": "phone with nothing selected",
      "product": "fx-nova", "selection": {},
      "expected": { "options": { "storage_gb": { "128": "available", "256": "available", "512": "available" }, "color": { "graphite": "available", "sand": "available" } },
        "resolved": null, "missing": ["storage_gb", "color"] } },
    { "id": "K10", "intent": "512 GB exists only in graphite",
      "product": "fx-nova", "selection": { "storage_gb": 512 },
      "expected": { "options": { "storage_gb": { "128": "available", "256": "available", "512": "selected" }, "color": { "graphite": "available", "sand": "unavailable" } },
        "resolved": null, "missing": ["color"] } },
    { "id": "K11", "intent": "sand is not offered with 512 GB: needs an explicit reset",
      "product": "fx-nova", "selection": { "storage_gb": 512 }, "select": { "attr": "color", "value": "sand" },
      "expected": { "status": "needs_reset", "conflicts": ["storage_gb"], "selection": { "storage_gb": 512 } } },
    { "id": "K12", "intent": "sand exists only with 256 GB",
      "product": "fx-nova", "selection": { "color": "sand" },
      "expected": { "options": { "storage_gb": { "128": "unavailable", "256": "available", "512": "unavailable" }, "color": { "graphite": "available", "sand": "selected" } },
        "resolved": null, "missing": ["storage_gb"] } }
  ]
}
