{
  "name": "dreamcart",
  "version": "0.1.0",
  "private": true,
  "description": "DreamCart: a virtual shopping experience built around real products and clearly simulated transactions.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "coverage": "vitest run --coverage",
    "test:browser": "playwright test",
    "catalog:check": "node tools/run-ts.mjs tools/catalog-cli.ts check",
    "catalog:import": "node tools/run-ts.mjs tools/catalog-cli.ts import",
    "prebuild": "npm run catalog:check",
    "docs:check": "node tools/check-docs.mjs",
    "smoke": "node tools/smoke-routes.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run docs:check && npm run format:check && npm run licenses && npm run build && npm run smoke",
    "licenses": "node tools/licenses.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
